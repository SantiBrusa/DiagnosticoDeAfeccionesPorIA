<div class="afecciones-header">
  <h1 class="page-title">Afecciones</h1>
  <a href="/afecciones/nueva" class="btn-primary">+ Nueva afección</a>
</div>

<div class="table-responsive">
  <table class="afecciones-table">
    <thead>
      <tr>
        <th>Imagen</th>
        <th>Nombre</th>
        <th>Síntomas</th>
        <th>Descripción</th>
        <th>Acciones</th>
      </tr>
    </thead>
    <tbody>
      {{#each afecciones}}
        <tr>
          <td>
            {{#if this.image}}
              <img src="{{this.image}}" alt="{{this.nombre}}" class="table-img" />
            {{else}}
              <span class="no-img">Sin imagen</span>
            {{/if}}
          </td>
          <td class="fw-bold">{{this.nombre}}</td>
          <td>
            {{#each this.sintomas}}
              <span class="tag-sintoma">{{this}}</span>{{#unless @last}}, {{/unless}}
            {{/each}}
          </td>
          <td>{{this.descripcion}}</td>
          <td>
            <div class="action-cell">
              {{#if this.diagnostico}}
                <span class="badge-success">✔ Diagnosticada</span>
                <a href="/afecciones/{{this._id}}/diagnostico" class="btn-sm btn-outline">Ver diagnóstico</a>
              {{else}}
                <a href="/afecciones/{{this._id}}/diagnostico" class="btn-sm btn-ia">Diagnosticar por IA</a>
              {{/if}}

              <a href="/afecciones/{{this._id}}/editar" class="btn-sm btn-edit">Editar</a>

              <form action="/afecciones/{{this._id}}/eliminar" method="POST" style="display:inline"
                    onsubmit="return confirm('¿Eliminar esta afección?');">
                <button type="submit" class="btn-sm btn-danger">Eliminar</button>
              </form>
            </div>
          </td>
        </tr>
      {{else}}
        <tr><td colspan="5" class="empty-state">Todavía no hay afecciones cargadas.</td></tr>
      {{/each}}
    </tbody>
  </table>
</div>

<script>
  document.querySelectorAll(".btn-diagnosticar").forEach((btn) => {
    btn.addEventListener("click", () => { 
      const id = btn.dataset.id; // TODO: acá llamaremos a la ruta que use la IA 
      console.log("Diagnosticar afección:", id);
    }); 
  });
</script>
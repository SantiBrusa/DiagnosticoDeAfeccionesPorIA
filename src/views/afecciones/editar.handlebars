<h1>Editar afección</h1>

{{#if error}}<p style="color:red">{{error}}</p>{{/if}}

<form action="/afecciones/{{afeccion._id}}/editar" method="POST" enctype="multipart/form-data">
  <label>Nombre
    <input type="text" name="nombre" value="{{afeccion.nombre}}" required>
  </label>

  <label>Síntomas (separados por coma)
    <input type="text" name="sintomas" value="{{sintomasTexto}}" required>
  </label>

  <label>Descripción
    <textarea name="descripcion" rows="4" required>{{afeccion.descripcion}}</textarea>
  </label>

  {{#if afeccion.image}}
    <p>Imagen actual:</p>
    <img src="{{afeccion.image}}" alt="{{afeccion.nombre}}" width="120">
  {{/if}}

  <label>Cambiar imagen (opcional)
    <input type="file" name="image" accept="image/*">
  </label>

  <button type="submit">Guardar cambios</button>
  <a href="/afecciones">Cancelar</a>
</form>
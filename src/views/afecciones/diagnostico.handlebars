<div class="form-container">
  <div class="form-header">
    <h1 class="page-title">Diagnóstico por IA</h1>
  </div>

  <div class="form-card">
    <div id="diagnostico" class="diagnostico-resultado" data-id="{{afeccion._id}}"
        data-existe="{{#if afeccion.diagnostico}}true{{else}}false{{/if}}">
      {{#if afeccion.diagnostico}}
        <p><strong>Posible afección:</strong> {{afeccion.diagnostico.afeccion}}</p>
        <p><strong>Explicación:</strong> {{afeccion.diagnostico.explicacion}}</p>
        <p><strong>Gravedad:</strong> {{afeccion.diagnostico.gravedad}}</p>
        <p><strong>Recomendaciones:</strong> {{afeccion.diagnostico.recomendaciones}}</p>
        <p><strong>Consultar médico:</strong>
          {{#if afeccion.diagnostico.consultar_medico}}Sí{{else}}No{{/if}}</p>
        <p><small class="fecha-txt">Diagnosticada el {{fechaDiagnostico}}</small></p>
      {{else}}
        <div class="ia-loading">Analizando con IA...</div>
      {{/if}}
    </div>

    <div class="form-actions">
      <a href="/afecciones" class="btn-close">Volver</a>
      <button type="button" id="btn-reintentar" class="btn-save" {{#unless afeccion.diagnostico}}hidden{{/unless}}>
        {{#if afeccion.diagnostico}}Volver a diagnosticar{{else}}Reintentar{{/if}}
      </button>
    </div>
  </div>
</div>

<script>
  const contenedor = document.getElementById("diagnostico");
  const btn = document.getElementById("btn-reintentar");
  const id = contenedor.dataset.id;

  function mostrar(datos) {
    contenedor.innerHTML = "";
    const lineas = [
      ["Posible afección", datos.afeccion],
      ["Explicación", datos.explicacion],
      ["Gravedad", datos.gravedad],
      ["Recomendaciones", datos.recomendaciones],
      ["Consultar médico", datos.consultar_medico ? "Sí" : "No"],
      ["Diagnosticada el", new Date(datos.fecha).toLocaleString("es-AR")],
    ];
    lineas.forEach(([titulo, valor]) => {
      const p = document.createElement("p");
      const b = document.createElement("strong");
      b.textContent = titulo + ": ";
      p.append(b, document.createTextNode(valor));
      contenedor.appendChild(p);
    });
  }

  async function diagnosticar() {
    contenedor.innerHTML = '<div class="ia-loading">Analizando con IA...</div>';
    btn.hidden = true;

    try {
      const res = await fetch(`/ia/diagnosticar/${id}`, { method: "POST" });
      const datos = await res.json();
      if (!res.ok) throw new Error(datos.error || "Error al diagnosticar");

      mostrar(datos);
      btn.textContent = "Volver a diagnosticar";
    } catch (error) {
      contenedor.innerHTML = `<div class="error-msg">No se pudo diagnosticar: ${error.message}</div>`;
      btn.textContent = "Reintentar";
    } finally {
      btn.hidden = false;
    }
  }

  btn.addEventListener("click", diagnosticar);

  // Solo consulta a la IA si todavía no hay un diagnóstico guardado
  if (contenedor.dataset.existe === "false") diagnosticar();
</script>